[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/lobby/room_lobby.gd" id="1_room_lobby"]
[ext_resource type="Theme" path="res://scenes/lobby/lobby_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://scenes/ui/game_logo.png" id="3_logo"]
[ext_resource type="PackedScene" path="res://scenes/lobby/player_input_panels.tscn" id="4_panels"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
content_margin_left = 40.0
content_margin_top = 28.0
content_margin_right = 40.0
content_margin_bottom = 32.0
bg_color = Color(0.08, 0.067, 0.125, 0.88)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 1, 1, 0.2)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

[node name="RoomLobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_room_lobby")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("3_logo")
expand_mode = 1
stretch_mode = 6

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.043, 0.035, 0.07, 0.82)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Card" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="Panel" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Card/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.54, 1)
theme_override_font_sizes/font_size = 56
text = "房間等候"
horizontal_alignment = 1

[node name="Slot1Button" type="Button" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SeatMine"
text = "玩家 1"

[node name="Slot2Button" type="Button" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SeatOther"
text = "玩家 2"

[node name="SeatHintLabel" type="Label" parent="Center/Card/Panel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.6)
theme_override_font_sizes/font_size = 22
text = "點選玩家 1／玩家 2 切換角色：玩家 1 用音高控制龍的高度，玩家 2 負責吸／吐"
horizontal_alignment = 1
autowrap_mode = 3

[node name="LocalIpLabel" type="Label" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.7)
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="Center/Card/Panel"]
layout_mode = 2

[node name="SoloButton" type="Button" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
text = "以單機遊玩"

[node name="JoinBox" type="HBoxContainer" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="IpInput" type="LineEdit" parent="Center/Card/Panel/JoinBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "對方的 IP，例如 192.168.1.10"

[node name="JoinButton" type="Button" parent="Center/Card/Panel/JoinBox"]
unique_name_in_owner = true
layout_mode = 2
text = "加入別人房間"

[node name="StartButton" type="Button" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "開始遊戲"

[node name="LeaveButton" type="Button" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
text = "離開"

[node name="StatusLabel" type="Label" parent="Center/Card/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.8)
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1
autowrap_mode = 3

[node name="PlayerPanels" parent="." instance=ExtResource("4_panels")]
unique_name_in_owner = true
layout_mode = 1
